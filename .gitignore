.agents/
skills-lock.json

# vendored render dependency (copied in by the render pipeline)
**/gsap.min.js

# env & secrets (server-side only, never committed)
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
