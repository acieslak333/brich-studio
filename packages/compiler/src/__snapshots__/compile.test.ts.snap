      if (s.op === 'set') { tl.set(s.sel, s.to, s.at); }
      else if (s.op === 'fromTo') { tl.fromTo(s.sel, s.from, vars, s.at); }
      else { tl[s.op](s.sel, vars, s.at); }
    });
