<script>
(function(){
  var steps = [{"sel":"#df-panel-p-title","op":"from","to":{"opacity":0},"at":0,"dur":0.4,"ease":"power2.out"},{"sel":"#df-panel-p-title .df-title","op":"from","to":{"opacity":0,"y":12},"at":0,"dur":0.4},{"sel":"#df-panel-p-title .df-subtitle","op":"from","to":{"opacity":0,"y":12},"at":0.08,"dur":0.4},{"sel":"#df-panel-p-chart","op":"from","to":{"opacity":0,"y":28},"at":3,"dur":0.4,"ease":"power2.out"},{"sel":"#df-panel-p-chart .df-bar","op":"fromTo","to":{"scaleY":1,"stagger":0.08,"ease":"power2.out"},"at":3,"dur":0.5,"from":{"scaleY":0}},{"sel":"#df-panel-p-table","op":"from","to":{"opacity":0},"at":3.5,"dur":0.4,"ease":"power2.out"},{"sel":"#df-panel-p-table .df-tr","op":"from","to":{"opacity":0,"y":10,"stagger":0.08},"at":3.6,"dur":0.4}];
  function build(){
    if (typeof window === 'undefined' || !window.gsap) return false;
    var tl = window.gsap.timeline({ paused: true });
    steps.forEach(function(s){
      var vars = Object.assign({}, s.to, { duration: s.dur });
